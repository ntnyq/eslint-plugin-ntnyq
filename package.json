{
  "name": "eslint-plugin-ntnyq",
  "type": "module",
  "version": "0.19.2",
  "packageManager": "pnpm@12.18.0",
  "description": "An opinionated ESLint plugin.",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "ntnyq"
  ],
  "license": "MIT",
  "author": {
    "name": "ntnyq",
    "email": "ntnyq13@gmail.com"
  },
  "homepage": "https://eslint-plugin.ntnyq.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntnyq/eslint-plugin-ntnyq.git"
  },
  "bugs": {
    "url": "https://github.com/ntnyq/eslint-plugin-ntnyq/issues"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "deploy": "run-s build docs:build",
    "dev": "tsdown --watch",
    "docs:build": "pnpm -C docs run build",
    "docs:check": "node scripts/updateRuleDocs.ts --check",
    "docs:dev": "pnpm -C docs run dev",
    "docs:generate": "run-s build docs:generate:run",
    "docs:generate:run": "node scripts/updateRuleDocs.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build",
    "release": "run-s release:check release:version",
    "release:check": "run-s build docs:check format:check lint typecheck:src typecheck:tests typecheck:docs typecheck:tools test:run docs:build",
    "release:version": "bumpp",
    "test": "run-s build test:run",
    "test:run": "vitest",
    "typecheck": "run-s build typecheck:src typecheck:tests typecheck:docs typecheck:tools",
    "typecheck:docs": "pnpm -C docs run typecheck",
    "typecheck:src": "tsgo --noEmit -p src/tsconfig.json",
    "typecheck:tests": "tsgo --noEmit -p tests/tsconfig.json",
    "typecheck:tools": "tsgo --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "eslint": "^9.5.0 || ^10.0.0"
  },
  "dependencies": {
    "@ntnyq/utils": "^0.26.0",
    "@typescript-eslint/utils": "^8.72.2"
  },
  "devDependencies": {
    "@ntnyq/eslint-config": "^7.0.0-beta.30",
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.72.2",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "bumpp": "^12.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-eslint-plugin": "^7.6.2",
    "eslint-v9": "npm:eslint@9.5.0",
    "eslint-vitest-rule-tester": "^3.2.0",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.4",
    "oxfmt": "^0.78.0",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2"
  },
  "nano-staged": {
    "*.{js,ts,mjs,tsx,vue,md,yml,yaml,json}": "eslint --fix",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  }
}
